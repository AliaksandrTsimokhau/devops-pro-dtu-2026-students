{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["replicaCount", "image", "ingress", "readinessPath", "registryCredentials"],
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 2, "maximum": 4},
    "image": {
      "type": "object", "required": ["repository", "digest"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9.-]+(:[0-9]+)?/[a-z0-9._/-]+$"},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "readinessPath": {"type": "string", "pattern": "^/"},
    "ingress": {
      "type": "object", "required": ["enabled", "className", "host"],
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"type": "string", "minLength": 1},
        "host": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+[a-z0-9]$"}
      }
    },
    "registryCredentials": {
      "type": "object", "required": ["create", "server", "username", "password"],
      "properties": {"create": {"type": "boolean"}},
      "if": {"properties": {"create": {"const": true}}},
      "then": {"properties": {
        "server": {"type": "string", "minLength": 1},
        "username": {"type": "string", "minLength": 1},
        "password": {"type": "string", "minLength": 1}
      }}
    }
  }
}
